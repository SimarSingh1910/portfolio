# Copy to .env.local for local testing, and add the same keys as environment variables on Render.
# Google Analytics 4 measurement ID (analytics.google.com > Admin > Data streams). Leave empty to disable tracking.
VITE_GA_ID=
# Optional: Web3Forms access key (web3forms.com) so the contact form emails you directly. Empty = form opens the visitor's email app.
VITE_WEB3FORMS_KEY=
